<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<title>{{ fmt_str(r.company_name) }} — Research Report</title>
<style>
  :root{
    --teal:#0d8b7f; --teal-dark:#0a7368; --teal-head:#128577;
    --band:#0d8b7f; --grey:#f1f3f4; --grey2:#e8eaed; --ink:#1f2933;
    --line:#c9ccd1; --up:#1a9e5f; --down:#e2483d; --neutral:#f0b000;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;color:var(--ink);
    font-family:"Segoe UI",Arial,Helvetica,sans-serif;font-size:11.5px;line-height:1.32;}
  .page{position:relative;width:210mm;min-height:297mm;padding:9mm 9mm 14mm 9mm;
    background:#fff;page-break-after:always;overflow:hidden;}
  .page:last-child{page-break-after:auto;}

  /* ---- top spine ribbon on page 1 ---- */
  .ribbon{position:absolute;top:0;right:0;width:9mm;height:70mm;background:var(--teal);
    color:#fff;writing-mode:vertical-rl;text-orientation:mixed;text-align:center;
    font-weight:700;font-size:11px;letter-spacing:.5px;padding-top:6px;}

  /* ---- header ---- */
  .rer{color:var(--teal);font-size:22px;font-weight:800;margin:0;}
  .cname{font-size:26px;font-weight:800;margin:4px 0 2px;}
  .logo{position:absolute;top:9mm;right:12mm;text-align:right;}
  .logo .g{font-size:26px;font-weight:800;color:#111;letter-spacing:1px;}
  .logo .g span{color:var(--teal);}
  .logo .tag{font-size:7.5px;letter-spacing:2px;color:#555;}
  .ratingbox{position:absolute;top:21mm;right:12mm;width:64mm;text-align:center;}
  .ratingpill{border:1px solid #bbb;border-radius:6px;background:#f6f7f8;
    box-shadow:0 2px 3px rgba(0,0,0,.12);padding:3px 0;font-size:20px;font-weight:800;}
  .sector{border-bottom:2px solid var(--teal);padding-bottom:3px;margin-top:6px;
    display:flex;justify-content:space-between;font-size:11px;}
  .sector b{font-weight:600;}

  table{border-collapse:collapse;width:100%;}
  /* Tight vertical cell padding buys the room for a larger base font while
     keeping the fixed 4-page layout. */
  td,th{padding:1.5px 4px;vertical-align:middle;}

  /* key changes / stock meta */
  .meta{margin-top:6px;font-size:10.5px;}
  .meta td{border:1px solid var(--line);text-align:center;}
  .meta .lbl{background:var(--grey);font-weight:600;}
  .arrow{font-size:12px;font-weight:800;}
  .up{color:var(--up);} .down{color:var(--down);} .neutral{color:var(--neutral);}
  .rblock td{border:1px solid var(--line);font-size:12px;padding:5px 8px;}
  .rblock .k{font-weight:700;} .rblock .v{text-align:right;font-weight:800;}

  .asof{font-weight:700;font-size:9.5px;margin:6px 0 2px;}

  /* two-column body */
  .cols{display:flex;gap:7px;}
  .col-l{width:39%;} .col-r{width:61%;}

  .band{background:var(--band);color:#fff;font-weight:700;font-size:11.5px;padding:3px 5px;}
  .dtl td{border:1px solid var(--line);}
  .dtl tr:nth-child(even){background:var(--grey);}
  .dtl .r{text-align:right;}

  .sh th{background:var(--band);color:#fff;font-weight:700;text-align:center;border:1px solid var(--teal-dark);}
  .sh td{border:1px solid var(--line);text-align:right;}
  .sh td:first-child{text-align:left;}
  .sh tr:nth-child(even){background:var(--grey);}

  h2.sec{color:var(--teal);font-size:15px;font-weight:800;margin:2px 0 4px;}
  .headline{color:var(--teal);font-size:15px;font-weight:800;margin:0 0 4px;}
  .ov{font-weight:700;font-size:11.5px;margin-bottom:5px;}
  ul.k{margin:0 0 6px;padding-left:14px;}
  ul.k li{margin-bottom:4px;}
  p.body{margin:0 0 6px;text-align:justify;}
  .down-strong{font-weight:800;}

  /* estimate table (left col bottom) */
  .est th{background:var(--band);color:#fff;text-align:right;border:1px solid var(--teal-dark);}
  .est th:first-child{text-align:left;}
  .est td{border:1px solid var(--line);text-align:right;}
  .est td:first-child{text-align:left;font-style:italic;}
  .est tr:nth-child(even){background:var(--grey);}
  .est .plain td:first-child{font-style:normal;font-weight:600;}

  /* quarterly */
  .q th{background:var(--band);color:#fff;text-align:center;border:1px solid var(--teal-dark);font-size:10px;}
  .q td{border:1px solid var(--line);text-align:right;}
  .q td:first-child{text-align:left;}
  .q tr:nth-child(even){background:var(--grey);}

  /* page 2 charts */
  .chart-grid{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
  .chart-cell{width:calc(50% - 3px);}
  .chart-cell h3{color:var(--teal);font-size:14px;font-weight:800;margin:4px 0 0;}
  .chart-cell img{width:100%;height:auto;}

  /* deck-grounded extras */
  .opm td{border:1px solid var(--line);}
  .opm tr:nth-child(even){background:var(--grey);}
  .opm .v{text-align:right;font-weight:700;}
  .opm .c{text-align:right;font-size:10px;color:#5a6b7b;white-space:nowrap;}
  .ent th{background:var(--band);color:#fff;text-align:right;border:1px solid var(--teal-dark);font-size:10px;}
  .ent th:first-child{text-align:left;}
  .ent td{border:1px solid var(--line);text-align:right;}
  .ent td:first-child{text-align:left;}
  .ent tr:nth-child(even){background:var(--grey);}
  .ent .sub th{background:var(--teal-head);}
  .concern li::marker{color:var(--down);}

  .cie th{background:var(--band);color:#fff;text-align:center;border:1px solid var(--teal-dark);}
  .cie td{border:1px solid var(--line);text-align:center;}
  .cie tr:nth-child(even){background:var(--grey);}
  .cie .grp{background:var(--teal-head);}

  /* page 3 financials */
  .fin th{background:var(--band);color:#fff;text-align:right;border:1px solid var(--teal-dark);font-size:9px;}
  .fin th:first-child{text-align:left;}
  .fin td{border:1px solid var(--line);text-align:right;}
  .fin td:first-child{text-align:left;}
  .fin tr:nth-child(even){background:var(--grey);}
  .fin .grp td{background:#dcdee0;font-weight:700;text-align:left;}
  .finsub{color:var(--teal);font-size:12px;font-weight:800;margin:0 0 3px;}
  .finna{border:1px solid var(--line);background:var(--grey);color:#667085;
    font-style:italic;font-size:9px;padding:5px 6px;margin-bottom:2px;}

  /* page 4 */
  .rec th{background:var(--band);color:#fff;text-align:center;border:1px solid var(--teal-dark);}
  .rec td{border:1px solid var(--line);text-align:center;}
  .rec tr:nth-child(even){background:var(--grey);}
  .crit th{background:var(--band);color:#fff;border:1px solid var(--teal-dark);}
  .crit td{border:1px solid var(--line);}
  .crit tr:nth-child(even){background:var(--grey);}
  .disc{font-size:8px;line-height:1.3;text-align:justify;color:#333;}
  .disc b{color:#111;}
  .disc h4{margin:4px 0 1px;font-size:9px;color:var(--teal);}

  /* footer */
  .footer{position:absolute;bottom:0;left:0;right:0;height:9mm;background:var(--teal);
    color:#fff;text-align:center;font-size:11px;font-weight:600;line-height:9mm;}
  .tophead{background:var(--teal);height:14mm;margin:-9mm -9mm 5mm -9mm;position:relative;}
  .tophead .logo2{position:absolute;right:10mm;top:3mm;color:#fff;font-size:18px;font-weight:800;letter-spacing:1px;}
  .tophead .logo2 .tag{font-size:6.5px;letter-spacing:2px;display:block;font-weight:400;}
</style>
</head>
<body>

{% macro fin_table(title, corner, years, data, fmt_num) %}
<div class="finsub">{{ title }}</div>
{% if data %}
<table class="fin">
  <tr><th style="text-align:left;">{{ corner }}</th>{% for y in years %}<th>{{ y }}</th>{% endfor %}</tr>
  {% for metric, row in data.items() %}
  <tr>
    <td>{{ metric.strip() }}</td>
    {% for y in years %}
      {% set v = row.get(y) %}
      <td>{% if v is none %}-{% else %}{{ fmt_num(v, 1) if (v|abs) < 1000 and (v != (v|round)) else fmt_num(v) }}{% endif %}</td>
    {% endfor %}
  </tr>
  {% endfor %}
</table>
{% else %}
<div class="finna">Not disclosed in source document.</div>
{% endif %}
{% endmacro %}

{# ============================= PAGE 1 ============================= #}
<div class="page">
  <div class="ribbon">{{ fmt_str(r.report_tag) }}</div>
  <div class="logo"><div class="g">G<span>GEOJIT</span></div><div class="tag">PEOPLE YOU PROSPER WITH</div></div>

  <h1 class="rer">Retail Equity Research</h1>
  <div class="cname">{{ fmt_str(r.company_name) }}</div>

  <div class="ratingbox">
    <div class="ratingpill">{{ fmt_str(r.rating) }}</div>
  </div>

  <div class="sector"><span>Sector:&nbsp; <b>{{ fmt_str(r.sector) }}</b></span><span style="font-weight:600;">{{ fmt_str(r.report_date) }}</span></div>

  <div class="cols" style="margin-top:6px;">
    <div style="width:64%;">
      <table class="meta">
        <tr>
          <td class="lbl">Key Changes</td>
          <td class="lbl">Target</td>
          <td class="arrow {{ r.change_target or 'neutral' }}">{% if r.change_target=='up' %}▲{% elif r.change_target=='down' %}▼{% else %}●{% endif %}</td>
          <td class="lbl">Rating</td>
          <td class="arrow {{ r.change_rating or 'neutral' }}">{% if r.change_rating=='up' %}▲{% elif r.change_rating=='down' %}▼{% else %}●{% endif %}</td>
          <td class="lbl">Earnings</td>
          <td class="arrow {{ r.change_earnings or 'neutral' }}">{% if r.change_earnings=='up' %}▲{% elif r.change_earnings=='down' %}▼{% else %}●{% endif %}</td>
        </tr>
        <tr>
          <td class="lbl">Stock Type</td><td>Bloomberg</td><td>Sensex</td><td>NSE Code</td><td>BSE Code</td><td colspan="2">Time Frame</td>
        </tr>
        <tr>
          <td>{{ fmt_str(r.stock_type) }}</td>
          <td>{{ fmt_str(r.bloomberg_code) }}</td>
          <td>{{ fmt_num(r.sensex) }}</td>
          <td>{{ fmt_str(r.nse_code) }}</td>
          <td>{{ fmt_str(r.bse_code) }}</td>
          <td colspan="2">{{ fmt_str(r.time_frame) }}</td>
        </tr>
      </table>
    </div>
    <div style="width:36%;">
      <table class="rblock">
        <tr><td class="k">Target</td><td class="v">{{ fmt_price(r.target_price) }}</td></tr>
        <tr><td class="k">CMP</td><td class="v">{{ fmt_price(r.current_price) }}</td></tr>
        <tr><td class="k">Return</td><td class="v">{% if r.return_pct is not none %}+{{ fmt_num(r.return_pct) }}%{% else %}{{ NA }}{% endif %}</td></tr>
      </table>
    </div>
  </div>

  <div class="asof">Data as of:&nbsp; {{ fmt_str(r.data_as_of) }}</div>

  <div class="cols">
    {# -------- LEFT COLUMN -------- #}
    <div class="col-l">
      <table class="dtl">
        <tr><td class="band" colspan="2">Company Data</td></tr>
        <tr><td>Market Cap (Rs.cr)</td><td class="r">{{ fmt_num(r.company_data.market_cap) }}</td></tr>
        <tr><td>52 Week High — Low (Rs.)</td><td class="r">{{ fmt_num(r.company_data.week52_high) }} - {{ fmt_num(r.company_data.week52_low) }}</td></tr>
        <tr><td>Enterprise Value (Rs. cr)</td><td class="r">{{ fmt_num(r.company_data.enterprise_value) }}</td></tr>
        <tr><td>Outstanding Shares (cr)</td><td class="r">{{ fmt_num(r.company_data.outstanding_shares,1) }}</td></tr>
        <tr><td>Free Float (%)</td><td class="r">{{ fmt_num(r.company_data.free_float_pct,1) }}</td></tr>
        <tr><td>Dividend Yield (%)</td><td class="r">{% if r.company_data.dividend_yield_pct is none %}-{% else %}{{ fmt_num(r.company_data.dividend_yield_pct,1) }}{% endif %}</td></tr>
        <tr><td>6m average volume (cr)</td><td class="r">{{ fmt_num(r.company_data.avg_volume_6m,1) }}</td></tr>
        <tr><td>Beta</td><td class="r">{{ fmt_num(r.company_data.beta,1) }}</td></tr>
        <tr><td>Face value (Rs. )</td><td class="r">{{ fmt_num(r.company_data.face_value,1) }}</td></tr>
      </table>

      {% if r.shareholding_pattern %}
      <table class="sh" style="margin-top:3px;">
        <tr><th style="text-align:left;">Shareholding (%)</th>{% for s in r.shareholding_pattern %}<th>{{ s.period }}</th>{% endfor %}</tr>
        <tr><td>Promoters</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.promoters_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>FII's</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.fii_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>MFs/Institutions</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.institutions_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>Public</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.public_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>Others</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.others_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>Total</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_num(s.total_pct,1) }}</td>{% endfor %}</tr>
        <tr><td>Promoter Pledge</td>{% for s in r.shareholding_pattern %}<td>{{ fmt_str(s.promoter_pledge) }}</td>{% endfor %}</tr>
      </table>
      {% endif %}

      {% if r.price_performance %}
      <table class="sh" style="margin-top:3px;">
        <tr><th style="text-align:left;">Price Performance</th><th>3 Month</th><th>6 Month</th><th>1 Year</th></tr>
        {% for p in r.price_performance %}
        <tr><td>{{ p.label }}</td><td>{{ fmt_num(p.m3,1) }}%</td><td>{{ fmt_num(p.m6,1) }}%</td><td>{{ fmt_num(p.y1,1) }}%</td></tr>
        {% endfor %}
      </table>
      <div style="font-size:8px;font-style:italic;">*over or under performance to benchmark index</div>
      {% endif %}

      {% if charts.price_1y %}
      <div style="margin-top:4px;"><img src="{{ charts.price_1y }}" style="width:100%;height:auto;"/></div>
      {% endif %}

      {% if r.yearly_estimates %}
      <table class="est" style="margin-top:3px;">
        <tr><th>Y.E March (cr)</th>{% for y in r.yearly_estimates %}<th>{{ y.year }}</th>{% endfor %}</tr>
        <tr class="plain"><td>Sales</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.sales) }}</td>{% endfor %}</tr>
        <tr><td>Growth (%)</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.sales_growth_pct,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>EBITDA</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.ebitda) }}</td>{% endfor %}</tr>
        <tr><td>EBITDA Margin (%)</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.ebitda_margin_pct,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>PAT Adjusted</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.pat_adjusted) }}</td>{% endfor %}</tr>
        <tr><td>Growth (%)</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.pat_growth_pct,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>Adjusted EPS</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.adjusted_eps,1) }}</td>{% endfor %}</tr>
        <tr><td>Growth (%)</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.eps_growth_pct,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>P/E</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.pe,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>P/B</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.pb,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>EV/EBITDA</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.ev_ebitda,1) }}</td>{% endfor %}</tr>
        <tr><td>ROE (%)</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.roe_pct,1) }}</td>{% endfor %}</tr>
        <tr class="plain"><td>D/E</td>{% for y in r.yearly_estimates %}<td>{{ fmt_num(y.de,1) }}</td>{% endfor %}</tr>
      </table>
      {% endif %}

      {% if r.operational_metrics %}
      <table class="opm" style="margin-top:3px;">
        <tr><td class="band" colspan="3">Operational Metrics</td></tr>
        {% for m in r.operational_metrics %}
        <tr><td>{{ m.label }}</td><td class="v">{{ fmt_str(m.value) }}</td><td class="c">{{ fmt_str(m.change) }}</td></tr>
        {% endfor %}
      </table>
      {% endif %}

      {% if r.capacity_profile %}
      <table class="sh" style="margin-top:3px;">
        <tr><th style="text-align:left;">Capacity Profile</th><th>Installed</th><th>U/C</th><th>Pipeline</th></tr>
        {% for c in r.capacity_profile %}
        <tr><td>{{ c.segment }}</td><td>{{ fmt_num(c.installed) }}{% if c.unit %} {{ c.unit }}{% endif %}</td><td>{{ fmt_num(c.under_construction) }}</td><td>{{ fmt_num(c.pipeline) }}</td></tr>
        {% endfor %}
      </table>
      {% endif %}
    </div>

    {# -------- RIGHT COLUMN -------- #}
    <div class="col-r">
      <div class="headline">{{ fmt_str(r.headline) }}</div>
      {% if r.company_overview %}<div class="ov">{{ r.company_overview }}</div>{% endif %}
      <ul class="k">
        {% for b in r.key_highlights_short %}<li>{{ b }}</li>{% endfor %}
      </ul>

      <h2 class="sec">Outlook &amp; Valuation</h2>
      {% if r.outlook_valuation %}<p class="body">{{ r.outlook_valuation }}</p>{% endif %}

      <h2 class="sec">Quarterly Financials Consolidated</h2>
      {% if r.quarterly_financials %}
      <table class="q">
        <tr><th style="text-align:left;">Rs.cr</th><th>{{ fmt_str(r.q_current_label) }}</th><th>{{ fmt_str(r.q_year_ago_label) }}</th><th>YoY Growth (%)</th><th>{{ fmt_str(r.q_prev_label) }}</th><th>QoQ Growth (%)</th></tr>
        {% for m in r.quarterly_financials %}
        <tr>
          <td>{{ m.metric }}</td>
          <td>{{ fmt_num(m.current_q,2) if m.metric.startswith('Adj. EPS') else fmt_num(m.current_q,1) if m.metric=='Margin (%)' else fmt_num(m.current_q) }}</td>
          <td>{{ fmt_num(m.year_ago_q,2) if m.metric.startswith('Adj. EPS') else fmt_num(m.year_ago_q,1) if m.metric=='Margin (%)' else fmt_num(m.year_ago_q) }}</td>
          <td>{{ fmt_growth(m.yoy_growth, m.is_bps) }}</td>
          <td>{{ fmt_num(m.prev_q,2) if m.metric.startswith('Adj. EPS') else fmt_num(m.prev_q,1) if m.metric=='Margin (%)' else fmt_num(m.prev_q) }}</td>
          <td>{{ fmt_growth(m.qoq_growth, m.is_bps) }}</td>
        </tr>
        {% endfor %}
      </table>
      {% endif %}

      {% if r.investment_rationale %}
      <h2 class="sec" style="margin-top:6px;">Investment Rationale</h2>
      <ul class="k">
        {% for b in r.investment_rationale %}<li>{{ b }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>

  <div class="footer">www.geojit.com</div>
</div>

{# ============================= PAGE 2 ============================= #}
<div class="page">
  <div class="tophead"><div class="logo2">G GEOJIT<span class="tag">PEOPLE YOU PROSPER WITH</span></div></div>

  <h2 class="sec">Key highlights</h2>
  <ul class="k">
    {% for b in r.key_highlights %}<li>{{ b }}</li>{% endfor %}
  </ul>

  <div class="chart-grid">
    {% if charts.revenue %}<div class="chart-cell"><h3>{{ r.revenue_chart.label or "Revenue" }}</h3><img src="{{ charts.revenue }}"/></div>{% endif %}
    {% if charts.gov %}<div class="chart-cell"><h3>{{ r.gov_chart.label or "Gross Order Value" }}</h3><img src="{{ charts.gov }}"/></div>{% endif %}
    {% if charts.ebitda %}<div class="chart-cell"><h3>{{ r.ebitda_chart.label or "EBITDA" }}</h3><img src="{{ charts.ebitda }}"/></div>{% endif %}
    {% if charts.pat %}<div class="chart-cell"><h3>{{ r.pat_chart.label or "PAT" }}</h3><img src="{{ charts.pat }}"/></div>{% endif %}
  </div>

  {% if r.change_in_estimates %}
  <h2 class="sec" style="margin-top:8px;">Change in Estimates</h2>
  <table class="cie">
    <tr>
      <th></th><th class="grp" colspan="2">Old estimates</th>
      <th class="grp" colspan="2">New estimates</th>
      <th class="grp" colspan="2">Change (%)</th>
    </tr>
    <tr><th>Year / Rs cr</th><th>FY26E</th><th>FY27E</th><th>FY26E</th><th>FY27E</th><th>FY26E</th><th>FY27E</th></tr>
    {% for c in r.change_in_estimates %}
    <tr>
      <td>{{ c.label }}</td>
      <td>{{ fmt_num(c.old_fy26,1) if c.is_bps else fmt_num(c.old_fy26) }}</td>
      <td>{{ fmt_num(c.old_fy27,1) if c.is_bps else fmt_num(c.old_fy27) }}</td>
      <td>{{ fmt_num(c.new_fy26,1) if c.is_bps else fmt_num(c.new_fy26) }}</td>
      <td>{{ fmt_num(c.new_fy27,1) if c.is_bps else fmt_num(c.new_fy27) }}</td>
      <td>{{ fmt_growth(c.change_fy26, c.is_bps) }}</td>
      <td>{{ fmt_growth(c.change_fy27, c.is_bps) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if r.key_concerns %}
  <h2 class="sec" style="margin-top:8px;">Key Concerns &amp; Risks</h2>
  <ul class="k concern">{% for b in r.key_concerns %}<li>{{ b }}</li>{% endfor %}</ul>
  {% endif %}

  {% if r.entity_financials %}
  <h2 class="sec" style="margin-top:8px;">Entity-wise Financials (Rs.cr)</h2>
  <table class="ent">
    <tr class="sub">
      <th rowspan="2" style="text-align:left;vertical-align:bottom;">Entity</th>
      <th colspan="2">Revenue</th><th colspan="2">EBITDA</th>
    </tr>
    <tr class="sub">
      <th>{{ fmt_str(r.entity_period_current) }}</th><th>{{ fmt_str(r.entity_period_prior) }}</th>
      <th>{{ fmt_str(r.entity_period_current) }}</th><th>{{ fmt_str(r.entity_period_prior) }}</th>
    </tr>
    {% for e in r.entity_financials %}
    <tr>
      <td>{{ e.entity }}</td>
      <td>{{ fmt_num(e.revenue_current) }}</td><td>{{ fmt_num(e.revenue_prior) }}</td>
      <td>{{ fmt_num(e.ebitda_current) }}</td><td>{{ fmt_num(e.ebitda_prior) }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if r.guidance %}
  <h2 class="sec" style="margin-top:8px;">Guidance &amp; Growth Roadmap</h2>
  <ul class="k">{% for g in r.guidance %}<li>{{ g }}</li>{% endfor %}</ul>
  {% endif %}

  {% if charts.entity or charts.capacity %}
  <div class="chart-grid" style="margin-top:6px;">
    {% if charts.entity %}<div class="chart-cell"><h3>Entity-wise {{ charts.entity_measure or "Revenue" }}</h3><img src="{{ charts.entity }}"/></div>{% endif %}
    {% if charts.capacity %}<div class="chart-cell"><h3>Capacity Roadmap</h3><img src="{{ charts.capacity }}"/></div>{% endif %}
  </div>
  {% endif %}

  <div class="footer">www.geojit.com</div>
</div>

{# ============================= PAGE 3 ============================= #}
<div class="page">
  <div class="tophead"><div class="logo2">G GEOJIT<span class="tag">PEOPLE YOU PROSPER WITH</span></div></div>
  <h2 class="sec">Consolidated Financials</h2>

  <div class="cols">
    <div style="width:49%;">
      {{ fin_table("Profit & Loss", "Y.E March (Rs. Cr)", r.financial_years, r.profit_loss, fmt_num) }}
      <div style="margin-top:8px;"></div>
      {{ fin_table("Cashflow", "Y.E March", r.financial_years, r.cashflow, fmt_num) }}
    </div>
    <div style="width:49%;">
      {{ fin_table("Balance Sheet", "Y.E March (Rs. Cr)", r.financial_years, r.balance_sheet, fmt_num) }}
      <div style="margin-top:8px;"></div>
      {{ fin_table("Ratio", "Y.E March", r.financial_years, r.ratios, fmt_num) }}
    </div>
  </div>
  <div class="footer">www.geojit.com</div>
</div>

{# ============================= PAGE 4 ============================= #}
<div class="page">
