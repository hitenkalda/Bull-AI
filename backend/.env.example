# Bull AI — Financial Research Report Generator
# Environment configuration template. Copy to `.env` and fill in values.
# `.env` is git-ignored — never commit real keys.

# Google Gemini API key (https://aistudio.google.com/apikey).
# If blank, the app runs in MOCK extraction mode (deterministic sample data)
# so the pipeline still works end-to-end offline.
GEMINI_API_KEY=

# Gemini model used for multimodal structured extraction.
GEMINI_MODEL=gemini-flash-latest

# Max upload size (megabytes). Larger uploads are rejected with HTTP 413.
MAX_UPLOAD_MB=15

# Max number of PDF pages rasterized to images for the multimodal prompt.
# More pages = better extraction, slower and pricier call.
MAX_PDF_PAGES_TO_IMAGE=6

# Backfill empty market fields (CMP, market cap, 52-week range, beta,
# dividend yield, price history) from yfinance. Set false to skip the stage.
ENABLE_MARKET_DATA=true
